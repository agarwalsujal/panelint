          "mimeType": "text/html;profile=mcp-app",
          "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Board</title>\n<link rel=\"stylesheet\" href=\"https://cdn.conformant-server.test/board.css\" integrity=\"sha384-oqVuAfXRKap7fdgcCY5uykM6+R9GqQ8K/uxy9rx7HNQlGYl1kPzQho1wx4JwY8wC\" crossorigin=\"anonymous\">\n<style>\n  body { font: 15px/1.5 system-ui, sans-serif; margin: 0; padding: 16px; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Board</h1>\n  <ul id=\"items\"></ul>\n</main>\n<script>\n  fetch('https://api.conformant-server.test/v1/items')\n    .then((r) => r.json())\n    .then((items) => {\n      const list = document.getElementById('items');\n      for (const item of items) {\n        const li = document.createElement('li');\n        li.textContent = item.label;\n        list.append(li);\n      }\n    });\n</script>\n</body>\n</html>\n"
        }
