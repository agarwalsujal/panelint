        {
          "uri": "ui://conformant/report",
          "mimeType": "text/html;profile=mcp-app",
          "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Report</title>\n<style>\n  body { font: 15px/1.5 system-ui, sans-serif; margin: 0; padding: 16px; }\n  table { border-collapse: collapse; width: 100%; }\n  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid currentColor; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Report</h1>\n  <table><thead><tr><th scope=\"col\">Region</th><th scope=\"col\">Total</th></tr></thead>\n  <tbody id=\"rows\"></tbody></table>\n</main>\n<script>\n  async function load() {\n    const res = await fetch('https://api.conformant-server.test/v1/totals');\n    const rows = await res.json();\n    const body = document.getElementById('rows');\n    for (const row of rows) {\n      const tr = document.createElement('tr');\n      const region = document.createElement('td');\n      region.textContent = row.region;\n      const total = document.createElement('td');\n      total.textContent = row.total;\n      tr.append(region, total);\n      body.append(tr);\n    }\n  }\n  load();\n</script>\n</body>\n</html>\n",
          "_meta": {
            "ui": {
              "csp": {
                "connectDomains": [
                  "https://api.conformant-server.test"
                ]
              }
            }
          }
        }
      ]
    }
