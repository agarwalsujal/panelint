          "mimeType": "text/html;profile=mcp-app",
          "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Scene</title>\n<style>\n  html, body { height: 100%; margin: 0; background: #101014; }\n  canvas { display: block; width: 100%; height: 100%; }\n  /* Viewport-filling, and NO z-index is declared. PANE-OVERLAY-001 must not\n     read \"fills the viewport\" alone as elevation — absent z-index is not\n     elevated, and this is an error state, not a clickjacking surface. */\n  .error-overlay {\n    position: absolute;\n    inset: 0;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    color: #f4f4f5;\n    font: 14px/1.5 system-ui, sans-serif;\n    background: #101014;\n  }\n  .error-overlay[data-shown=\"true\"] { display: flex; }\n</style>\n</head>\n<body>\n<main>\n  <canvas id=\"gl\"></canvas>\n  <div class=\"error-overlay\" id=\"err\" role=\"alert\"></div>\n</main>\n<script type=\"module\">\n  import { createApp } from './sdk.js';\n  import * as THREE from './three.module.js';\n\n  const app = createApp();\n\n  // The app's CORE EXECUTION MECHANISM: the model supplies an animation\n  // expression and the app compiles it. 'unsafe-eval' is absent from the\n  // mandated default CSP, so this only runs where the server declared it.\n  function compileAnimation(body) {\n    return new Function('mesh', 't', body);\n  }\n\n  function fail(message) {\n    const el = document.getElementById('err');\n    el.textContent = message;\n    el.dataset.shown = 'true';\n  }\n\n  app.ready().then((ctx) => {\n    const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('gl') });\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);\n    camera.position.z = 4;\n    const mesh = new THREE.Mesh(new THREE.BoxGeometry(), new THREE.MeshNormalMaterial());\n    scene.add(mesh);\n\n    let step;\n    try {\n      step = compileAnimation(ctx.toolResult?.animation ?? 'mesh.rotation.y = t;');\n    } catch (e) {\n      fail('Could not compile the animation: ' + e.message);\n      return;\n    }\n\n    renderer.setAnimationLoop((ms) => {\n      step(mesh, ms / 1000);\n      renderer.render(scene, camera);\n    });\n  });\n</script>\n</body>\n</html>\n"
        }
      ]
