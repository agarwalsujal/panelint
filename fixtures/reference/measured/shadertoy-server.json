          "mimeType": "text/html;profile=mcp-app",
          "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Shader</title>\n<style>\n  html, body { height: 100%; margin: 0; background: #000; }\n  canvas { display: block; width: 100%; height: 100%; }\n  .log { position: absolute; bottom: 0; left: 0; right: 0; max-height: 8rem; overflow: auto;\n         font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: #f88; padding: 0.5rem; }\n</style>\n</head>\n<body>\n<main>\n  <canvas id=\"gl\"></canvas>\n  <pre class=\"log\" id=\"log\" aria-live=\"polite\"></pre>\n</main>\n\n<script type=\"x-shader/x-vertex\" id=\"vs\">\nattribute vec2 aPos;\nvoid main() { gl_Position = vec4(aPos, 0.0, 1.0); }\n</script>\n\n<script type=\"x-shader/x-fragment\" id=\"fs-header\">\nprecision highp float;\nuniform vec2 uResolution;\nuniform float uTime;\n</script>\n\n<script type=\"module\">\n  import { createApp } from './sdk.js';\n\n  const app = createApp();\n  const log = document.getElementById('log');\n\n  // The model-supplied shader body is GLSL compiled by the GPU driver, not by\n  // JavaScript. It is text concatenation into gl.shaderSource, not eval.\n  function buildFragment(body) {\n    return document.getElementById('fs-header').textContent + '\\n' + body;\n  }\n\n  function compile(gl, type, source) {\n    const sh = gl.createShader(type);\n    gl.shaderSource(sh, source);\n    gl.compileShader(sh);\n    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {\n      log.textContent = gl.getShaderInfoLog(sh) ?? 'shader compilation failed';\n      return null;\n    }\n    return sh;\n  }\n\n  app.ready().then((ctx) => {\n    const gl = document.getElementById('gl').getContext('webgl');\n    const vs = compile(gl, gl.VERTEX_SHADER, document.getElementById('vs').textContent);\n    const fs = compile(gl, gl.FRAGMENT_SHADER, buildFragment(ctx.toolResult?.shader ?? 'void main(){ gl_FragColor = vec4(0.0); }'));\n    if (!vs || !fs) return;\n    const prog = gl.createProgram();\n    gl.attachShader(prog, vs);\n    gl.attachShader(prog, fs);\n    gl.linkProgram(prog);\n    gl.useProgram(prog);\n  });\n</script>\n</body>\n</html>\n"
        }
