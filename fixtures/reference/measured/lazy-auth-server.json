          "uri": "ui://lazy-auth/connect",
          "mimeType": "text/html;profile=mcp-app",
          "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Connect</title>\n<style>\n  body { font: 14px/1.5 system-ui, sans-serif; margin: 0; padding: 1.5rem; max-width: 40rem; }\n  button { min-height: 44px; padding: 0 1rem; }\n  button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }\n  button[disabled] { opacity: 0.6; cursor: not-allowed; }\n  .state { margin-top: 1rem; }\n  .state[data-kind=\"error\"] { color: #b00020; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Connect your account</h1>\n  <p>Authorization happens in your browser. Nothing is entered here — this app\n     never asks for a password.</p>\n  <button type=\"button\" id=\"start\">Open the authorization page</button>\n  <p class=\"state\" id=\"state\" role=\"status\">Not connected.</p>\n</main>\n<script type=\"module\">\n  import { createApp } from './sdk.js';\n\n  const app = createApp();\n  const state = document.getElementById('state');\n  const start = document.getElementById('start');\n\n  function setState(kind, text) {\n    state.dataset.kind = kind;\n    state.textContent = text;\n  }\n\n  async function poll(handle) {\n    for (let attempt = 0; attempt < 60; attempt++) {\n      const status = await app.callTool('check_auth_status', { handle });\n      if (status.state === 'authorized') { setState('ok', 'Connected.'); return; }\n      if (status.state === 'denied') { setState('error', 'Authorization was declined.'); return; }\n      await new Promise((r) => setTimeout(r, 2000));\n    }\n    setState('error', 'Timed out waiting for authorization.');\n  }\n\n  start.addEventListener('click', async () => {\n    start.disabled = true;\n    setState('pending', 'Waiting for authorization…');\n    // The authorization URL is issued by the server per attempt, so it cannot\n    // be a literal here. The host decides whether to honour openLink.\n    const session = await app.callTool('begin_auth', {});\n    app.openLink(session.authorizationUrl);\n    await poll(session.handle);\n  });\n</script>\n</body>\n</html>\n"
        }
      ]
    }
