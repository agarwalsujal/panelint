          "mimeType": "text/html;profile=mcp-app",
          "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>PDF</title>\n<style>\n  html, body { height: 100%; margin: 0; font: 14px/1.5 system-ui, sans-serif; }\n  .main { display: grid; grid-template-rows: auto 1fr; height: 100%; }\n  /* Fullscreen container. Not an overlay: it is the app's own root, and it\n     covers nothing it did not already own. */\n  .main.fullscreen { position: fixed; inset: 0; background: Canvas; }\n  .toolbar { display: flex; gap: 0.25rem; padding: 0.25rem; border-bottom: 1px solid #ddd; }\n  .toolbar button { min-height: 44px; min-width: 44px; }\n  .toolbar button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }\n  .pages { overflow: auto; }\n  /* A modal confirm dialog. z-index IS declared here, and it still must not\n     produce a finding on its own: a modal that the user opened is not a\n     clickjacking surface. PANE-OVERLAY-001 requires a second signal. */\n  .confirm-dialog { position: fixed; inset: 0; z-index: 1000; display: none;\n                    align-items: center; justify-content: center; background: rgba(0,0,0,0.4); }\n  .confirm-dialog[open] { display: flex; }\n  .confirm-dialog .box { background: Canvas; padding: 1rem; max-width: 24rem; }\n  svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; }\n</style>\n</head>\n<body>\n<main class=\"main\" id=\"main\">\n  <div class=\"toolbar\">\n    <button type=\"button\" id=\"icon-prev\" aria-label=\"Previous page\"></button>\n    <button type=\"button\" id=\"icon-next\" aria-label=\"Next page\"></button>\n    <button type=\"button\" id=\"icon-zoom-in\" aria-label=\"Zoom in\"></button>\n    <button type=\"button\" id=\"icon-zoom-out\" aria-label=\"Zoom out\"></button>\n    <button type=\"button\" id=\"icon-fit\" aria-label=\"Fit to width\"></button>\n    <button type=\"button\" id=\"icon-print\" aria-label=\"Print\"></button>\n    <button type=\"button\" id=\"icon-full\" aria-label=\"Full screen\"></button>\n    <button type=\"button\" id=\"icon-close\" aria-label=\"Close\"></button>\n  </div>\n  <div class=\"pages\" id=\"pages\"></div>\n</main>\n<div class=\"confirm-dialog\" id=\"confirm\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"confirm-title\">\n  <div class=\"box\">\n    <h2 id=\"confirm-title\">Print this document?</h2>\n    <p id=\"confirm-body\"></p>\n    <button type=\"button\" id=\"confirm-ok\">Print</button>\n    <button type=\"button\" id=\"confirm-cancel\">Cancel</button>\n  </div>\n</div>\n<script type=\"module\">\n  import { createApp } from './sdk.js';\n  // pdf.js resolves its Standard-14 font files at runtime from the same origin\n  // it was loaded from, which is why resourceDomains carries the CDN.\n  import * as pdfjs from 'https://unpkg.com/pdfjs-dist@4.6.82/build/pdf.min.mjs';\n\n  pdfjs.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@4.6.82/build/pdf.worker.min.mjs';\n\n  const app = createApp();\n  const pages = document.getElementById('pages');\n  const confirmBody = document.getElementById('confirm-body');\n\n  // Eleven innerHTML assignment sites: eight static icon-SVG string literals\n  // and three clears. Every one is a LITERAL. PANE-DOM-001 requires a\n  // NON-LITERAL assigned expression precisely because of this shape — the\n  // original rule fired eleven times on this file.\n  function paintIcons() {\n    document.getElementById('icon-prev').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M10 3 5 8l5 5z\"/></svg>';\n    document.getElementById('icon-next').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M6 3l5 5-5 5z\"/></svg>';\n    document.getElementById('icon-zoom-in').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M7 3v8M3 7h8\"/></svg>';\n    document.getElementById('icon-zoom-out').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 7h8\"/></svg>';\n    document.getElementById('icon-fit').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"10\" height=\"10\"/></svg>';\n    document.getElementById('icon-print').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 6h8v5H4z\"/></svg>';\n    document.getElementById('icon-full').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 3h4M3 3v4M13 13H9M13 13V9\"/></svg>';\n    document.getElementById('icon-close').innerHTML = '<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 4l8 8M12 4l-8 8\"/></svg>';\n  }\n\n  function clearAll() {\n    pages.innerHTML = '';\n    confirmBody.innerHTML = '';\n    document.getElementById('confirm-title').innerHTML = '';\n  }\n\n  async function render(url) {\n    clearAll();\n    const doc = await pdfjs.getDocument(url).promise;\n    for (let n = 1; n <= doc.numPages; n++) {\n      const page = await doc.getPage(n);\n      const viewport = page.getViewport({ scale: 1.25 });\n      const canvas = document.createElement('canvas');\n      canvas.width = viewport.width;\n      canvas.height = viewport.height;\n      pages.append(canvas);\n      await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;\n    }\n  }\n\n  document.getElementById('icon-full').addEventListener('click', () => {\n    document.getElementById('main').classList.toggle('fullscreen');\n  });\n  document.getElementById('icon-print').addEventListener('click', () => {\n    confirmBody.textContent = 'The document will be sent to the system print dialog.';\n    document.getElementById('confirm').setAttribute('open', '');\n  });\n  document.getElementById('confirm-cancel').addEventListener('click', () => {\n    document.getElementById('confirm').removeAttribute('open');\n  });\n\n  paintIcons();\n  app.ready().then((ctx) => render(ctx.toolResult.url));\n</script>\n</body>\n</html>\n"
        }
